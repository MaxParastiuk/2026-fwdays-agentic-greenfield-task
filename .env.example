# Vercel AI Gateway — free monthly credits on every Vercel team.
# Model browser (free-tier filter): https://vercel.com/ai-gateway/models?freeTier=true
#
# Local dev: link the project and pull env, or create a key in the dashboard
#   vercel link
#   vercel env pull .env.local
#
# Or paste a gateway key from: Vercel dashboard → AI Gateway → API keys
AI_GATEWAY_API_KEY=

# Optional override (Gateway provider/model format). Defaults to a free-tier Flash model.
# MODEL_ID=google/gemini-2.5-flash-lite
