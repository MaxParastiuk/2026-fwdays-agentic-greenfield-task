{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/results/**",
              "ui_kits/job_application_agent/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Newsreader|Public Sans|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Newsreader, Public Sans, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconRight|loading|fullWidth|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconRight, loading, fullWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:elevation|padding|as|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: elevation, padding, as."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='elevation'] > Literal[value!=/^(?:flat|raised|floating)$/]",
        "message": "<Card> elevation must be one of 'flat' | 'raised' | 'floating'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='padding'] > Literal[value!=/^(?:none|sm|md|lg)$/]",
        "message": "<Card> padding must be one of 'none' | 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CollapsiblePreview'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|text|limit|defaultOpen|confirmedLabel|className|style|key|ref|className|style|children)$/]",
        "message": "<CollapsiblePreview> doesn't accept that prop. Declared props: title, text, limit, defaultOpen, confirmedLabel, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CopyButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|label|copiedLabel|variant|size|className|style|key|ref|className|style|children)$/]",
        "message": "<CopyButton> doesn't accept that prop. Declared props: text, label, copiedLabel, variant, size, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CopyButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost)$/]",
        "message": "<CopyButton> variant must be one of 'primary' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CopyButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<CopyButton> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ErrorBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|message|actionLabel|onRetry|className|style|key|ref|className|style|children)$/]",
        "message": "<ErrorBanner> doesn't accept that prop. Declared props: title, message, actionLabel, onRetry, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GapList'] > JSXAttribute > JSXIdentifier[name!=/^(?:gaps|emptyLabel|className|style|key|ref|className|style|children)$/]",
        "message": "<GapList> doesn't accept that prop. Declared props: gaps, emptyLabel, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|size|solid|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, size, solid, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<IconButton> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Iteration'] > JSXAttribute > JSXIdentifier[name!=/^(?:iteration|score|rationale|gaps|key|ref|className|style|children)$/]",
        "message": "<Iteration> doesn't accept that prop. Declared props: iteration, score, rationale, gaps."
      },
      {
        "selector": "JSXOpeningElement[name.name='LetterPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:letter|title|finalScore|iterations|model|showCopy|onCopy|className|style|key|ref|className|style|children)$/]",
        "message": "<LetterPanel> doesn't accept that prop. Declared props: letter, title, finalScore, iterations, model, showCopy, onCopy, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressStep'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|phase|status|key|ref|className|style|children)$/]",
        "message": "<ProgressStep> doesn't accept that prop. Declared props: label, phase, status."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressStep'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:done|active|pending)$/]",
        "message": "<ProgressStep> status must be one of 'done' | 'active' | 'pending'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScoreBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:score|max|size|showMax|className|style|key|ref|className|style|children)$/]",
        "message": "<ScoreBadge> doesn't accept that prop. Declared props: score, max, size, showMax, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScoreBadge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<ScoreBadge> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|icon|key|ref|className|style|children)$/]",
        "message": "<SegmentedOption> doesn't accept that prop. Declared props: value, label, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusIndicator'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|label|className|style|key|ref|className|style|children)$/]",
        "message": "<StatusIndicator> doesn't accept that prop. Declared props: state, label, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusIndicator'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:idle|running|complete|error)$/]",
        "message": "<StatusIndicator> state must be one of 'idle' | 'running' | 'complete' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|icon|mono|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: tone, icon, mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|accent|pass|mid|fail)$/]",
        "message": "<Tag> tone must be one of 'neutral' | 'accent' | 'pass' | 'mid' | 'fail'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextArea'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|count|mono|style|key|ref|className|style|children)$/]",
        "message": "<TextArea> doesn't accept that prop. Declared props: label, hint, count, mono, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|icon|style|key|ref|className|style|children)$/]",
        "message": "<TextField> doesn't accept that prop. Declared props: label, hint, error, icon, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='UploadedFile'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|key|ref|className|style|children)$/]",
        "message": "<UploadedFile> doesn't accept that prop. Declared props: name, size."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
